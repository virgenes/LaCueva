# Bot
DISCORD_TOKEN=          # Token del bot (obligatorio)
CLIENT_ID=              # Application ID del bot
GUILD_ID=               # ID del servidor de Discord

# Bridge
BRIDGE_PORT=3001        # Puerto del servidor Bridge
BRIDGE_SECRET=          # Secret compartido Bot<->Bridge para autenticación interna
BRIDGE_CORS_ORIGIN=     # Origen permitido (URL de GitHub Pages)

# APIs externas
YOUTUBE_API_KEY=        # Para búsquedas de música
TENOR_API_KEY=          # Para comando /gif
REDDIT_CLIENT_ID=       # Para comando /meme
REDDIT_CLIENT_SECRET=   # Para comando /meme

# Bot owner & integraciones
OWNER_ID=               # ID del dueño del bot (para comandos de dev)
TWITCH_CLIENT_ID=       # Para notificaciones de Twitch
TWITCH_CLIENT_SECRET=   # Para notificaciones de Twitch
WEATHER_API_KEY=        # Para comando /weather (OpenWeatherMap)
TRANSLATE_API_KEY=      # Para comando /translate
GENIUS_API_KEY=         # Para comando /lyrics (Genius)
URL_SHORTENER_API_KEY=  # Para comando /shorten
