{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "La Cueva Discord Bot",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "sh start.sh",
    "start:all": "pm2 start ecosystem.config.js",
    "stop:all": "pm2 stop ecosystem.config.js",
    "logs": "pm2 logs discord-bot",
    "dev": "tsx src/index.ts",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/rest": "^2.0.0",
    "@discordjs/voice": "^0.17.0",
    "@distube/ytdl-core": "^4.14.0",
    "better-sqlite3": "^9.4.0",
    "discord.js": "^14.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "genius-lyrics": "^4.4.4",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.0",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.16.0",
    "ytsr": "^3.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "fast-check": "^3.15.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  }
}
